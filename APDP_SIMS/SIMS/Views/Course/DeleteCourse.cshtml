@model SIMS.Models.Course

@{
    ViewData["Title"] = "Delete Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2 class="my-4">Delete Course</h2>
    <p>Are you sure you want to delete this course?</p>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@Model.CourseName</h5>
            <p class="card-text"><strong>Semester:</strong> @Model.Semester</p>
            <p class="card-text"><strong>Credits:</strong> @Model.Credits</p>
            <p class="card-text"><strong>Description:</strong> @Model.Description</p>
            <p class="card-text"><strong>Created At:</strong> @Model.CreatedAt.ToShortDateString()</p>
        </div>
    </div>

    <form asp-action="ConfirmDeleteCourse" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CourseId" />
        <div class="form-group mt-4">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a href="@Url.Action("DashboardCourse", "Course")" class="btn btn-secondary ml-2">Cancel</a>
        </div>
    </form>
</div>
