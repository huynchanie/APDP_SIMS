@model IEnumerable<SIMS.Models.Course>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="container mt-5">
    <h2 class="text-center mb-4" style="color: #4CAF50; font-size: 2rem; font-weight: bold;">
        📚 Manager Courses List
    </h2>

    @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
    {
        <div class="mb-4 d-flex justify-content-end">
            <a asp-action="CreateCourse" class="btn btn-success">
                ➕ Add New Course
            </a>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover table-bordered">
            <thead class="thead-light">
                <tr>
                    <th class="text-center">Semester</th>
                    <th class="text-center">ID</th>
                    <th class="text-center">Course</th>
                    <th class="text-center">Credits</th>
                    <th class="text-center">Description</th>
                    <th class="text-center">Date</th>
                    @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                    {
                        <th class="text-center">Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td class="text-center">@course.Semester</td>
                            <td class="text-center">@course.CourseId</td>
                            <td class="text-center">@course.CourseName</td>
                            <td class="text-center">@course.Credits</td>
                            <td class="text-center">@course.Description</td>
                            <td class="text-center">@course.CreatedAt.ToString("dd/MM/yyyy")</td>
                            @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                            {
                                <td class="text-center">
                                    <a asp-action="EditCourse" asp-route-id="@course.CourseId"
                                       class="btn btn-warning btn-sm mr-2">
                                        ✏️ Edit
                                    </a>
                                    <form asp-action="DeleteCourse" asp-route-id="@course.CourseId"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this course?');">
                                            🗑️ Delete
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            No courses available.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
