@model SIMS.Models.Grade

@{
    ViewData["Title"] = "Add Grade";
}

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4" style="width: 40%;">
        <h2 class="text-center mb-4">Add Grade</h2>
        <form asp-action="AssignGrade" method="post">
            <div class="mb-3">
                <label class="form-label">Student</label>
                <select asp-for="UserId" class="form-select" asp-items="ViewBag.Students">
                    <option value="">-- Select Student --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Course</label>
                <select asp-for="CourseId" class="form-select" asp-items="ViewBag.Courses">
                    <option value="">-- Select Course --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Grade</label>
                <input asp-for="Score" type="number" min="0" max="100" step="1" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Notes</label>
                <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Teacher</label>
                <input type="text" class="form-control" value="@ViewBag.TeacherName" readonly />
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-success">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
